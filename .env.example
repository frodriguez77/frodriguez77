# Copiar este archivo a .env y completar con tus datos reales
# NUNCA subir el archivo .env a git

# Credenciales del sistema judicial
SISFE_USUARIO=tu_usuario_matriculado
SISFE_PASSWORD=tu_contraseña

# Email donde recibir las notificaciones
EMAIL_DESTINATARIO=tu_email@gmail.com

# Cuenta desde la que se envía (puede ser la misma)
EMAIL_REMITENTE=tu_email@gmail.com

# Contraseña de aplicación de Gmail (no la contraseña normal)
# Generarla en: Cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
EMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx

# SMTP (dejar así para Gmail)
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PUERTO=587

# Cuántos días hacia atrás buscar cédulas (1 = solo el día anterior + hoy)
DIAS_BUSQUEDA=1

# Archivo donde se guarda el historial para no renotificar
ARCHIVO_ESTADO=cedulas_vistas.json
